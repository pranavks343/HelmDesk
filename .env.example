# Used both for local (non-Docker) runs and interpolated into infra/docker-compose.yml.

POSTGRES_DSN=postgresql+asyncpg://supportpilot:supportpilot@localhost:5432/supportpilot
MONGO_URI=mongodb://localhost:27017
MONGO_DB=supportpilot
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-this-for-any-shared-environment
INTERNAL_SERVICE_TOKEN=replace-this-for-any-shared-environment
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

NOTIFIER_GRPC_TARGET=localhost:50051

# agent-worker: "fake" (default, offline, deterministic) or "anthropic" (needs a real key below)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

VITE_API_BASE_URL=http://localhost:8000
